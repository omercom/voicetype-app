{
  "manifest_version": 3,
  "name": "VoiceType — Türkçe Metni Seslendir",
  "version": "1.2.0",
  "minimum_chrome_version": "113",
  "description": "Seçili metnin yanında okuma butonu gösterir. Mac'teki VoiceType uygulaması metni yerelde Türkçe seslendirir.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "action": { "default_title": "Seçili metnin okuma butonuna odaklan" },
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
